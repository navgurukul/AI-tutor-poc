# Backend API base URL (classes, subjects, tutor Q&A)
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to use a built-in mock tutor reply instead of calling the backend.
# Handy for running/inspecting the frontend before the backend exists.
VITE_USE_MOCK_API=false

# Piper voice model files (served from apps/frontend/public/models/)
VITE_VOICE_MODEL_URL=/models/en_US-amy-medium.onnx
VITE_VOICE_CONFIG_URL=/models/en_US-amy-medium.json
