# Backend API base URL (classes, subjects, tutor Q&A)
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to use a built-in mock tutor reply instead of calling the backend.
# Handy for running/inspecting the frontend before the backend exists.
VITE_USE_MOCK_API=false

# Answers are read aloud with the browser's built-in speech synthesizer
# (window.speechSynthesis) — no model files. It uses the OS voices, so for
# offline Hindi/Marathi audio the matching Windows speech pack must be installed
# (Settings -> Time & Language -> Speech). Nothing to configure here.
