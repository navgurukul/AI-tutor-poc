# Copy to .env to override. All values are optional.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# How long Ollama keeps the model in RAM once idle. -1 never unloads (no reload
# pause mid-lesson, ~1.2GB held); 0 unloads immediately; "30m"/"1h" also work.
# Ollama's own default is 5m, which costs a ~2s reload after any longer pause.
OLLAMA_KEEP_ALIVE=-1
# Load the model at boot instead of on the first question. Non-blocking.
WARM_MODEL_ON_STARTUP=true

# Generation defaults
TEMPERATURE=0.3
MAX_TOKENS=400
NUM_CTX=4096

# Conversation memory
HISTORY_QUESTIONS=1
SESSION_TTL_MINUTES=180

# Comma-separated origins, or * for any (fine for a local POC)
CORS_ORIGINS=*

# --- Retrieval (RAG) ---
# Requires Python 3.11+ (sqlite-vec needs SQLite extension loading) and
# `ollama pull nomic-embed-text`. With it unavailable the tutor still answers,
# just without textbook grounding.
RAG_ENABLED=true
RAG_DB_PATH=data/library.db
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIMS=768
# Passages pasted into the prompt. Each one costs prefill time on a CPU-bound
# model -- that, not the search, is the latency cost of retrieval.
RAG_TOP_K=2
# Hard ceiling on retrieved text. Prefill is ~25ms per new token on the target
# laptop, so this is what actually bounds how long a grounded answer waits.
RAG_CONTEXT_MAX_CHARS=800
# Longest any one passage may be; a longer one is cut to the sentences that
# best match the question. 0 turns shortening off.
RAG_PASSAGE_MAX_CHARS=600
# Cosine distance cut-off; above this a hit counts as irrelevant.
RAG_MAX_DISTANCE=0.42

# Ingest-time corpus filtering. A textbook's exercises and activity boxes are
# ABOUT the chapter's topic, so they embed next to the definition and outrank
# it -- and a fill-in-the-blanks question is the definition with the answer
# deleted. Measured on the Class 6 book: "What are the poles of a magnet?"
# retrieved the p.121 exercise first and the tutor filled the blanks in
# backwards. Applies at INGEST, so changing it means re-ingesting the PDF.
# Check any new book with scripts/eval/corpus_filter_report.py first.
RAG_FILTER_CORPUS=true
# Share of a page that must be exercise apparatus before the page is treated as
# an exercise and reduced to its "What we have learnt" summary. A page also needs
# an explicit instruction ("Fill in the blanks", "Match the pairs"), and on this
# book that is what keeps lesson pages safe: some reach 0.43 but carry none.
RAG_EXERCISE_PAGE_RATIO=0.40
# Prepend "Class 6 > Science > <heading>" to a chunk before embedding. Headings
# are validated first, so a junk one ("28620C") becomes no heading rather than
# noise in the vector. Set false to embed the prose alone and A/B the two.
RAG_EMBED_BREADCRUMB=true

# Sized against RAG_PASSAGE_MAX_CHARS and RAG_CONTEXT_MAX_CHARS, not on its own:
# at 1200 the passage limit trimmed definitions out of 78% of chunks and context
# recall fell from 51% to 32%. See rag_chunk_chars in app/config.py.
RAG_CHUNK_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=105
RAG_EMBED_BATCH_SIZE=16
RAG_MAX_UPLOAD_MB=80
