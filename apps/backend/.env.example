# Copy to .env to override. All values are optional.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# How long Ollama keeps the model in RAM once idle. -1 never unloads (no reload
# pause mid-lesson, ~1.2GB held); 0 unloads immediately; "30m"/"1h" also work.
# Ollama's own default is 5m, which costs a ~2s reload after any longer pause.
OLLAMA_KEEP_ALIVE=-1
# Load the model at boot instead of on the first question. Non-blocking.
WARM_MODEL_ON_STARTUP=true

# Generation defaults
TEMPERATURE=0.7
MAX_TOKENS=800
NUM_CTX=4096

# Conversation memory
MAX_HISTORY_MESSAGES=20
SESSION_TTL_MINUTES=180

# Comma-separated origins, or * for any (fine for a local POC)
CORS_ORIGINS=*

# --- Retrieval (RAG) ---
# Requires Python 3.11+ (sqlite-vec needs SQLite extension loading) and
# `ollama pull nomic-embed-text`. With it unavailable the tutor still answers,
# just without textbook grounding.
RAG_ENABLED=true
RAG_DB_PATH=data/library.db
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIMS=768
# Passages pasted into the prompt. Each one costs prefill time on a CPU-bound
# model -- that, not the search, is the latency cost of retrieval.
RAG_TOP_K=4
# Cosine distance cut-off; above this a hit counts as irrelevant.
RAG_MAX_DISTANCE=0.42
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=180
RAG_EMBED_BATCH_SIZE=16
RAG_MAX_UPLOAD_MB=80
