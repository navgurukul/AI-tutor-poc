# Copy to .env to override. All values are optional.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# How long Ollama keeps the model in RAM once idle. -1 never unloads (no reload
# pause mid-lesson, ~1.2GB held); 0 unloads immediately; "30m"/"1h" also work.
# Ollama's own default is 5m, which costs a ~2s reload after any longer pause.
OLLAMA_KEEP_ALIVE=-1
# Load the model at boot instead of on the first question. Non-blocking.
WARM_MODEL_ON_STARTUP=true

# Generation defaults
TEMPERATURE=0.7
MAX_TOKENS=800
NUM_CTX=4096

# Conversation memory
MAX_HISTORY_MESSAGES=20
SESSION_TTL_MINUTES=180

# Comma-separated origins, or * for any (fine for a local POC)
CORS_ORIGINS=*
