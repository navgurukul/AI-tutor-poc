# Copy to .env to override. All values are optional.
OLLAMA_HOST=http://localhost:11434
# One model for every language. gemma2:2b, not qwen2.5:1.5b: the 1.5B model
# can't produce coherent Hindi/Marathi. A per-language split was tried and
# reverted — on a 4 GB box every language switch reloaded a model.
OLLAMA_MODEL=gemma2:2b
# Keep the model resident between questions ("-1" = never unload, or e.g. "30m").
# Ollama unloads after 5 min idle by default; the reload is ~10-20s on 4 GB.
OLLAMA_KEEP_ALIVE=-1
# Load the model into RAM when the backend starts (background, doesn't delay
# startup) so the first question isn't the one that pays the ~10-20s cold start.
WARM_MODEL_ON_STARTUP=true

# Generation defaults
TEMPERATURE=0.7
# Non-English turns run a little lower (less script drift) — not so low it loops.
TEMPERATURE_NON_ENGLISH=0.6
# Mild anti-repetition over Ollama's 1.1 / 64 defaults. Don't raise much:
# Devanagari function words repeat a lot, and a hard penalty garbles Hindi.
REPEAT_PENALTY=1.15
REPEAT_LAST_N=128
# A tutor answer is 2-3 short sentences + an example. Low on purpose — biggest
# CPU latency lever, and Hindi runs 2-4x more tokens/word. Raise if replies cut off.
MAX_TOKENS=200
NUM_CTX=3072

# Conversation memory — short: every replayed turn is re-processed on CPU.
MAX_HISTORY_MESSAGES=10
SESSION_TTL_MINUTES=180

# Comma-separated origins, or * for any (fine for a local POC)
CORS_ORIGINS=*

# Offline speech-to-text, all on sherpa-onnx, one engine per language (folders
# relative to apps/backend/, downloaded by scripts/setup.ps1):
#   Hindi/Marathi -> IndicConformer-600M CTC. STT_INDIC_FILE defaults to the
#     fp32 model.onnx (~470 MB); model.int8.onnx (~188 MB) is ~2x the WER.
#   English       -> Whisper base.en int8 (~155 MB). The folder auto-detects
#     Whisper vs Moonshine by its files, so pointing STT_ENGLISH_DIR at a
#     Moonshine model folder also works.
# STT_INDIC_DIR=models/indicconformer
# STT_INDIC_FILE=model.onnx
# STT_ENGLISH_DIR=models/stt/sherpa-onnx-whisper-base.en
# STT_NUM_THREADS=4

# Offline text-to-speech for non-English answers (sherpa-onnx + a Piper VITS
# voice — no extra package). English answers use the browser's own voice.
# The voice folder is placed by scripts/setup.ps1.
# TTS_MODEL_DIR=models/tts
# TTS_VOICE=vits-piper-hi_IN-priyamvada-medium
# TTS_NUM_THREADS=2
