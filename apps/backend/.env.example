# Copy to .env to override. All values are optional.
OLLAMA_HOST=http://localhost:11434
# One model for every language. gemma2:2b, not qwen2.5:1.5b: the 1.5B model
# can't produce coherent Hindi/Marathi. A per-language split was tried and
# reverted — on a 4 GB box every language switch reloaded a model.
OLLAMA_MODEL=gemma2:2b
# Keep the model resident between questions ("-1" = never unload, or e.g. "30m").
# Ollama unloads after 5 min idle by default; the reload is ~10-20s on 4 GB.
OLLAMA_KEEP_ALIVE=-1
# Load the model into RAM when the backend starts (background, doesn't delay
# startup) so the first question isn't the one that pays the ~10-20s cold start.
WARM_MODEL_ON_STARTUP=true

# How long Ollama keeps the model in RAM once idle. -1 never unloads (no reload
# pause mid-lesson, ~1.2GB held); 0 unloads immediately; "30m"/"1h" also work.
# Ollama's own default is 5m, which costs a ~2s reload after any longer pause.
OLLAMA_KEEP_ALIVE=-1
# Load the model at boot instead of on the first question. Non-blocking.
WARM_MODEL_ON_STARTUP=true

# Generation defaults
TEMPERATURE=0.7
# Non-English turns run a little lower (less script drift) — not so low it loops.
TEMPERATURE_NON_ENGLISH=0.6
# Mild anti-repetition over Ollama's 1.1 / 64 defaults. Don't raise much:
# Devanagari function words repeat a lot, and a hard penalty garbles Hindi.
REPEAT_PENALTY=1.15
REPEAT_LAST_N=128
# A tutor answer is 2-3 short sentences + an example. Low on purpose — biggest
# CPU latency lever, and Hindi runs 2-4x more tokens/word. Raise if replies cut off.
MAX_TOKENS=200
NUM_CTX=3072

# Conversation memory — short: every replayed turn is re-processed on CPU.
MAX_HISTORY_MESSAGES=10
SESSION_TTL_MINUTES=180

# Comma-separated origins, or * for any (fine for a local POC)
CORS_ORIGINS=*

# Offline speech-to-text, all on sherpa-onnx, one engine per language (folders
# relative to apps/backend/, downloaded by scripts/setup.ps1):
#   Hindi/Marathi -> IndicConformer-600M CTC. STT_INDIC_FILE defaults to the
#     fp32 model.onnx (~470 MB); model.int8.onnx (~188 MB) is ~2x the WER.
#   English       -> Whisper base.en int8 (~155 MB). The folder auto-detects
#     Whisper vs Moonshine by its files, so pointing STT_ENGLISH_DIR at a
#     Moonshine model folder also works.
# STT_INDIC_DIR=models/indicconformer
# STT_INDIC_FILE=model.onnx
# STT_ENGLISH_DIR=models/stt/sherpa-onnx-whisper-base.en
# STT_NUM_THREADS=4

# Offline text-to-speech (sherpa-onnx + one Piper VITS voice per language — no
# extra package). Each language gets a folder under TTS_MODEL_DIR named after it
# (english/, hindi/, marathi/), beside one shared espeak-ng-data/.
# Placed by scripts/setup.ps1.
# TTS_MODEL_DIR=models/tts
# TTS_NUM_THREADS=2
# TTS_SPEED=1.0

# --- Per-turn metrics ---
# Attach timings and the retrieval trace to every reply, and log one line per
# turn. On by default -- the latency story is invisible without it. Set false
# for a student-facing build (the panel is noise there) or when the log line is
# in the way: no `metrics` on the response, none in the SSE `done` frame, no log
# line, and no groundedness computed. The frontend panel then has nothing to
# render and disappears on its own.
METRICS_ENABLED=true

# --- Retrieval (RAG) ---
# Requires Python 3.11+ (sqlite-vec needs SQLite extension loading) and
# `ollama pull bge-m3`. With it unavailable the tutor still answers, just
# without textbook grounding.
RAG_ENABLED=true
RAG_DB_PATH=data/library.db
# bge-m3 is the only model measured to rank Hindi->English and
# Marathi->English correctly. Changing it is a background re-embed
# (POST /api/library/reembed), not a re-ingest.
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_DIMS=1024
# Passages pasted into the prompt. Each one costs prefill time on a CPU-bound
# model -- that, not the search, is the latency cost of retrieval. Measured
# 2026-09-04: ~15ms of prefill per prompt token, ~285 tokens per passage, so
# every passage is ~4.3s before the student hears anything.
RAG_TOP_K=3
# NOTE: RAG_MAX_DISTANCE is gone. One global cut-off cannot work across
# languages -- a correct hit sits at 0.21 for an English question and 0.51 for
# a Hindi one against the same page. It is replaced by a relative margin plus a
# per-query-language ceiling; see config.py.
RAG_RELATIVE_MARGIN=0.12
RAG_CEILING_EN=0.51
RAG_CEILING_HI=0.58
RAG_CEILING_MR=0.59
# 0.0 = retrieval OFF for romanized Indic. Measured, not tuned: bge-m3 ranks
# the correct chunk FARTHER than off-topic ones for Latin-script Hindi.
RAG_CEILING_ROMANIZED=0.0
# Splitting bounds in characters -- NOT a context budget (see
# RAG_CONTEXT_TOKEN_BUDGET). Packing aims at target; only a paragraph past max
# is split on sentences; anything under min is dropped.
RAG_CHUNK_TARGET_CHARS=1200
RAG_CHUNK_MAX_CHARS=2000
RAG_CHUNK_MIN_CHARS=40
RAG_CHUNK_OVERLAP_CHARS=180
RAG_EMBED_BATCH_SIZE=16
RAG_MAX_UPLOAD_MB=80
