# Repo-wide safety net. App-specific ignores (large downloaded model/runtime
# assets, etc.) live in apps/frontend/.gitignore.

# Python / backend
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Offline STT model (~104MB), downloaded by scripts/setup.ps1
apps/backend/models/

# Node / frontend
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# Env files
.env
.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
