# Repo-wide safety net. App-specific ignores (large downloaded model/runtime
# assets, etc.) live in apps/frontend/.gitignore.

# Python / backend
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node / frontend
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# Env files
.env
.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The textbook corpus: device data, not source. Built by ingestion, or copied
# in prebuilt -- either way it is large and machine-specific.
apps/backend/data/
*.db
*.db-wal
*.db-shm

# Offline speech models. Not used on this English-only branch (speech is
# browser-side), but 549 MB of them can be left in the working tree by a
# checkout from the multilingual branch -- never let that reach git.
apps/backend/models/

# Windows packaging output: multi-GB payload, installer artifacts and the
# download cache. build/ above already covers it; named here so it is obvious.
build/.cache/
build/dist/

# Source textbook PDFs. Third-party copyright and large: they are an input to
# the content build, not source to be redistributed through this repo.
data/
ps_cmds.txt
todo.txt


# Per-turn telemetry the backend writes at runtime (AITUTOR_LOG_DIR, default
# ./logs beside the app). Device data, not source -- same reason as data/.
apps/backend/logs/
Target HP data/
docs/ai-tutor-one-pager/*.png
docs/ingestion/ingestion-output-class6-pp104-118.docx
docs/testing/target-machine-questions.md
docs/ingestion/ingestion-redesign.docx
docs/ingestion/textbook-patterns-ncert-class1-10.docx
docs/ai-tutor-one-pager.md
